{
  // тёмная — как терминал (Vesper), светлая — One Light; переключается вместе с macOS
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Vesper",
  },

  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },

  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono", "Noto Color Emoji"],
  "buffer_font_size": 14.5,
  "buffer_font_weight": 400,
  "buffer_line_height": {
    "custom": 1.5,
  },

  "ui_font_family": "Inter",
  "ui_font_fallbacks": ["JetBrains Mono", "Symbols Nerd Font Mono"],
  "ui_font_size": 13.5,
  "ui_font_weight": 500,

  "base_keymap": "JetBrains",
  "vim_mode": false,

  "project_panel": {
    "dock": "left",
    "default_width": 280,
    "folder_indicator": "icon",
    "file_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "indent_size": 16,
    "scrollbar": {
      "show": "hover",
    },
    "show_diagnostics": "all",
  },

  "git_panel": {
    "dock": "left",
    "default_width": 280,
  },

  "outline_panel": {
    "dock": "left",
    "default_width": 260,
  },

  "collaboration_panel": {
    "dock": "left",
  },

  "agent": {
    "dock": "right",
    "default_width": 400,
    "button": true,
    "auto_compact": {
      "enabled": true,
      "threshold": "90%",
    },
  },

  "terminal": {
    "font_family": "JetBrains Mono",
    "font_fallbacks": ["Symbols Nerd Font Mono"],
    "font_size": 14,
    "line_height": "comfortable",
    "cursor_shape": "bar",
    "copy_on_select": true,
    "keep_selection_on_copy": true,
    "working_directory": "current_project_directory",
    "shell": "system",
    "toolbar": {
      "breadcrumbs": true,
    },
    "env": {
      "EDITOR": "zed --wait",
      "VISUAL": "zed --wait",
    },
  },

  "cursor_blink": false,
  "cursor_shape": "bar",
  "multi_cursor_modifier": "alt",
  "unnecessary_code_fade": 0.35,
  "vertical_scroll_margin": 6,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "current_line_highlight": "all",
  "selection_highlight": true,
  "rounded_selection": true,
  "show_line_numbers": true,
  "relative_line_numbers": "disabled",
  "show_git_gutter": true,
  "hover_popover_enabled": true,
  "hover_popover_delay": 250,
  "hover_popover_sticky": true,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "code_lens": "on",
  "soft_wrap": "editor_width",
  "wrap_guides": [100, 120],
  "show_wrap_guides": true,
  "use_smartcase_search": true,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,

  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "breakpoints": true,
    "code_actions": true,
    "folds": true,
    "min_line_number_digits": 3,
  },

  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": true,
      "vertical": true,
    },
  },

  "minimap": {
    "show": "auto",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "line",
    "max_width_columns": 64,
  },

  "search": {
    "button": true,
    "search_on_type": true,
    "center_on_match": true,
  },

  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "extend_comment_on_newline": true,
  "confirm_quit": true,
  "close_on_file_delete": true,
  "restore_on_file_reopen": true,

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  "restore_on_startup": "last_workspace",

  "session": {
    "restore_unsaved_buffers": true,
  },

  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 500,
    "scroll_debounce_ms": 50,
  },

  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
    },
  },

  "lsp_highlight_debounce": 75,

  "global_lsp_settings": {
    "button": true,
    "request_timeout": 120,
  },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
    "show_diagnostics": "all",
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
  },

  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": false,
    "enable_keep_preview_on_code_navigation": false,
  },

  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 100,
    "inline_blame": {
      "enabled": false,
      "delay_ms": 500,
      "min_column": 40,
      "show_commit_summary": true,
    },
    "branch_picker": {
      "show_author_name": true,
    },
    "hunk_style": "staged_hollow",
    "diff_base": "head",
  },

  "languages": {
    "Go": {
      "hard_tabs": true,
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },

    "YAML": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": "language_server",
      "soft_wrap": "editor_width",
    },

    "Dockerfile": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "Shell Script": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"],
        },
      },
    },

    "TOML": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "JSON": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 90,
      "remove_trailing_whitespace_on_save": false,
      "format_on_save": "off",
    },

    "Terraform": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "HCL": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "Python": {
      "tab_size": 4,
      "format_on_save": "on",
    },

    "TypeScript": {
      "tab_size": 2,
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },

    "TSX": {
      "tab_size": 2,
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
    },

    "Rust": {
      "tab_size": 4,
      "formatter": "language_server",
    },
  },

  "lsp": {
    "gopls": {
      "initialization_options": {
        "staticcheck": true,
        "gofumpt": true,
        "usePlaceholders": true,
        "completeUnimported": true,
        "analyses": {
          "unusedparams": true,
          "unusedwrite": true,
          "shadow": true,
          "nilness": true,
          "useany": true,
          "unusedresult": true,
        },
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
        "codelenses": {
          "generate": true,
          "regenerate_cgo": true,
          "tidy": true,
          "upgrade_dependency": true,
          "vendor": true,
          "test": true,
          "run_govulncheck": true,
        },
        "directoryFilters": [
          "-**/node_modules",
          "-**/.git",
          "-**/vendor",
          "-**/bin",
          "-**/dist",
          "-**/build",
          "-**/.venv",
          "-**/target",
        ],
      },
    },

    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "enable": true,
            "singleQuote": false,
          },
          "validate": true,
          "hover": true,
          "completion": true,
          "schemas": {
            "https://json.schemastore.org/github-workflow.json": [
              ".github/workflows/*.{yml,yaml}",
            ],
            "https://json.schemastore.org/docker-compose.json": [
              "docker-compose*.{yml,yaml}",
              "compose*.{yml,yaml}",
            ],
            "https://json.schemastore.org/kustomization.json": [
              "kustomization.{yml,yaml}",
            ],
          },
        },
      },
    },

    "terraform-ls": {
      "initialization_options": {
        "experimentalFeatures": {
          "prefillRequiredFields": true,
        },
      },
    },

    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "cargo": {
          "features": "all",
        },
      },
    },
  },

  "file_scan_exclusions": [
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/target",
    "**/dist",
    "**/build",
    "**/bin",
    "**/vendor",
    "**/.terraform",
    "**/.terragrunt-cache",
    "**/__pycache__",
    "**/.cache",
    "**/.idea",
    "**/.vscode",
    "**/coverage",
    "...",
  ],

  "file_scan_depth": 5,

  "file_types": {
    "Dockerfile": ["Dockerfile*", "Containerfile*"],
    "JSONC": ["tsconfig*.json", "jsconfig*.json", ".eslintrc.json"],
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "auto_update": true,

  // ставятся сами при первом запуске (и на новом маке)
  "auto_install_extensions": {
    "vesper": true,
    "material-icon-theme": true,
    "dockerfile": true,
    "docker-compose": true,
    "toml": true,
    "make": true,
    "sql": true,
    "git-firefly": true,
  },
}
