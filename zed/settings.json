// ============================================================
//   Zed — Go (Gin) / Docker / SQL / DevOps
//   ~/dotfiles/zed/settings.json  (симлинк в ~/.config/zed/)
//   Лёгкая замена VS Code: ~300 МБ вместо 1–2 ГБ — важно на 8 ГБ.
// ============================================================
{
  // ────────────────────────────────────────────────────────────
  //  ВНЕШНИЙ ВИД
  // ────────────────────────────────────────────────────────────

  // тёмная — своя Dev Night (zed/themes/, фиолетово-синяя), светлая — One Light; меняются вместе с macOS
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Dev Night",
  },
  // иконки файлов: своя тема (zed/icon-theme — значки как в терминале); в светлом режиме — Material
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Dev Night Icons",
  },

  // код — тот же шрифт, что в терминале (с иконками Nerd Font и лигатурами)
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14.5,
  "buffer_font_weight": 400,
  "buffer_line_height": { "custom": 1.6 },
  "buffer_font_features": { "calt": true },

  // интерфейс — системный шрифт macOS
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 14,

  "title_bar": {
    "show_branch_icon": true,
    "show_onboarding_banner": false,
    "show_user_picture": false,
  },

  // ────────────────────────────────────────────────────────────
  //  РЕДАКТОР
  // ────────────────────────────────────────────────────────────

  "base_keymap": "JetBrains",
  "vim_mode": false,

  "cursor_shape": "bar",
  "cursor_blink": false,
  "current_line_highlight": "all",
  "selection_highlight": true,
  "rounded_selection": true,
  "multi_cursor_modifier": "alt",

  // курсор не прилипает к краю экрана (как cursorSurroundingLines в VS Code)
  "vertical_scroll_margin": 8,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "unnecessary_code_fade": 0.4,

  "show_line_numbers": true,
  "relative_line_numbers": "disabled",
  "show_whitespaces": "boundary",
  "wrap_guides": [120],
  "show_wrap_guides": true,
  "soft_wrap": "none",

  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },

  "gutter": {
    "line_numbers": true,
    "runnables": true,     // ▶ у main и тестов — запуск в один клик
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 3,
  },

  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_symbol": true,
    "diagnostics": "all",
  },

  "minimap": {
    "show": "auto",
    "thumb": "always",
    "current_line_highlight": "line",
    "max_width_columns": 60,
  },

  // автоскобки, кавычки вокруг выделения, парные HTML-теги
  "use_autoclose": true,
  "use_auto_surround": true,
  "linked_edits": true,
  "auto_indent_on_paste": true,
  "extend_comment_on_newline": true,
  "use_smartcase_search": true,

  "hover_popover_enabled": true,
  "hover_popover_delay": 300,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,

  // подсказки типов от gopls (cmd-shift-i — спрятать/показать)
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 500,
    "scroll_debounce_ms": 50,
  },

  // ошибки прямо в строке (как Error Lens)
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
    },
  },

  // панель над редактором: путь к символу, быстрые действия, меню выделения
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
  },
  "search": { "button": true, "whole_word": false, "case_sensitive": false, "regex": false },
  "file_finder": { "modal_max_width": "medium", "file_icons": true },
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  // cmd-alt-l — текст по центру экрана (удобно читать README и длинные файлы)
  "centered_layout": { "left_padding": 0.18, "right_padding": 0.18 },

  // ────────────────────────────────────────────────────────────
  //  ФАЙЛЫ / СОХРАНЕНИЕ
  // ────────────────────────────────────────────────────────────

  // сохранение при уходе из файла (как в VS Code) — без формата посреди набора
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  "restore_on_startup": "last_workspace",
  "session": { "restore_unsaved_buffers": true },
  "restore_on_file_reopen": true,
  "close_on_file_delete": true,
  "confirm_quit": false,

  // не индексировать мусор — меньше памяти и быстрее поиск
  "file_scan_exclusions": [
    "**/.git",
    "**/.DS_Store",
    "**/node_modules",
    "**/vendor",
    "**/tmp",
    "**/bin",
    "**/dist",
    "**/build",
    "**/.venv",
    "**/__pycache__",
    "**/.terraform",
    "**/coverage",
  ],

  "file_types": {
    "Dockerfile": ["Dockerfile*", "Containerfile*"],
    "Shell Script": [".env", ".env.*", ".envrc"],
    "TOML": [".air.toml"],
    "JSONC": ["**/.zed/*.json", "**/zed/*.json", "tsconfig*.json"],
  },

  // ────────────────────────────────────────────────────────────
  //  ПАНЕЛИ И ВКЛАДКИ
  // ────────────────────────────────────────────────────────────

  "project_panel": {
    "dock": "left",
    "default_width": 280,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": false,       // как explorer.compactFolders: false
    "indent_size": 16,
    "indent_guides": { "show": "always" },
    "show_diagnostics": "errors",
  },
  "outline_panel": { "dock": "left", "default_width": 260 },
  "git_panel": { "dock": "left", "default_width": 280 },
  "collaboration_panel": { "button": false },
  "notification_panel": { "button": false },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
    "show_diagnostics": "errors",
    "activate_on_close": "history",
  },
  // не больше 10 вкладок, без «предпросмотра» (вкладка не подменяется при клике)
  "max_tabs": 10,
  "preview_tabs": { "enabled": false },

  // ────────────────────────────────────────────────────────────
  //  ТЕРМИНАЛ
  // ────────────────────────────────────────────────────────────

  "terminal": {
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13,
    "line_height": "comfortable",
    "cursor_shape": "bar",
    "blinking": "off",
    "copy_on_select": true,
    "keep_selection_on_copy": true,
    "option_as_meta": true,        // alt-c (fzf), alt-стрелки — как в Ghostty
    "working_directory": "current_project_directory",
    "shell": "system",
    "toolbar": { "breadcrumbs": false },
    "env": {
      "EDITOR": "zed --wait",
      "VISUAL": "zed --wait",
    },
  },

  // ────────────────────────────────────────────────────────────
  //  GIT
  // ────────────────────────────────────────────────────────────

  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 100,
    // кто и когда менял текущую строку (как GitLens); cmd-alt-b — вкл/выкл
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "min_column": 80,
      "show_commit_summary": true,
    },
    "hunk_style": "staged_hollow",
  },

  // ────────────────────────────────────────────────────────────
  //  ЯЗЫКИ
  // ────────────────────────────────────────────────────────────

  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],   // линтер прямо в редакторе
      "hard_tabs": true,
      "tab_size": 4,
      "preferred_line_length": 120,
      "formatter": "language_server",
      "code_actions_on_format": { "source.organizeImports": true },
    },
    "YAML": { "tab_size": 2, "hard_tabs": false },
    "Dockerfile": { "tab_size": 4 },
    "SQL": { "tab_size": 2, "format_on_save": "off" },
    "TOML": { "tab_size": 2 },
    "JSON": { "tab_size": 2 },
    "JSONC": { "tab_size": 2 },
    "Make": { "hard_tabs": true },
    "Shell Script": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"],
        },
      },
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "remove_trailing_whitespace_on_save": false,
      "format_on_save": "off",
    },
    "Python": { "tab_size": 4 },
    "Terraform": { "tab_size": 2 },
    "HCL": { "tab_size": 2 },
  },

  "lsp": {
    // golangci-lint v2: ошибки линтера подсвечиваются как обычные диагностики
    "golangci-lint": {
      "initialization_options": {
        "command": ["golangci-lint", "run", "--output.json.path=stdout", "--show-stats=false", "--issues-exit-code=1"],
      },
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
        "usePlaceholders": true,
        "completeUnimported": true,
        "analyses": {
          "nilness": true,
          "shadow": true,
          "unusedparams": true,
          "unusedwrite": true,
          "useany": true,
        },
        // те же подсказки, что в VS Code — без шума
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
        "codelenses": {
          "generate": true,
          "test": true,
          "tidy": true,
          "upgrade_dependency": true,
          "run_govulncheck": true,
        },
        // gopls не индексирует мусор — меньше памяти
        "directoryFilters": [
          "-**/node_modules",
          "-**/vendor",
          "-**/tmp",
          "-**/bin",
          "-**/dist",
          "-**/.venv",
        ],
      },
    },

    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": { "enable": true, "singleQuote": false },
          "validate": true,
          "hover": true,
          "completion": true,
          "schemas": {
            "https://json.schemastore.org/github-workflow.json": [".github/workflows/*.{yml,yaml}"],
            "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": [
              "docker-compose*.{yml,yaml}",
              "compose*.{yml,yaml}",
            ],
            "https://json.schemastore.org/golangci-lint.json": [".golangci.{yml,yaml}"],
            "https://json.schemastore.org/kustomization.json": ["kustomization.{yml,yaml}"],
          },
        },
      },
    },
  },

  // ────────────────────────────────────────────────────────────
  //  AI / ПРОЧЕЕ
  // ────────────────────────────────────────────────────────────

  "agent": {
    "dock": "right",
    "default_width": 420,
    "button": true,
  },

  "telemetry": { "diagnostics": false, "metrics": false },
  "auto_update": true,

  // ставятся сами при первом запуске (и на новом маке)
  "auto_install_extensions": {
    "material-icon-theme": true,
    "dockerfile": true,
    "docker-compose": true,
    "toml": true,
    "make": true,
    "sql": true,
    "git-firefly": true,
    "terraform": true,
    "golangci-lint": true,   // линтер Go в редакторе
    "http": true,            // .http-файлы: запросы к своему API прямо из Zed
    "env": true,             // подсветка .env
    "proto": true,
    "helm": true,
    "nginx": true,
    "log": true,             // подсветка логов
  },
}
