// Отладка Go (Delve) в Zed: f5 — выбрать конфигурацию, точки останова — клик по полю слева.
[
  {
    "label": "Go: cmd/api",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "$ZED_WORKTREE_ROOT/cmd/api",
    "cwd": "$ZED_WORKTREE_ROOT",
    "envFile": "$ZED_WORKTREE_ROOT/.env"
  },
  {
    "label": "Go: текущий пакет",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "$ZED_DIRNAME",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Go: тест под курсором",
    "adapter": "Delve",
    "request": "launch",
    "mode": "test",
    "program": "$ZED_DIRNAME",
    "args": ["-test.run", "^$ZED_SYMBOL$", "-test.v"]
  }
]
