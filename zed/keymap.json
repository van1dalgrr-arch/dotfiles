// Хоткеи Zed (поверх раскладки JetBrains). Все действия — cmd-shift-p.
[
  {
    "context": "Workspace",
    "bindings": {
      // панели
      "cmd-j": "terminal_panel::ToggleFocus",          // терминал
      "cmd-1": "project_panel::ToggleFocus",           // файлы
      "cmd-2": "outline_panel::ToggleFocus",           // структура файла
      "cmd-3": "git_panel::ToggleFocus",               // git: изменения, коммит
      "cmd-0": "workspace::ToggleLeftDock",
      "cmd-9": "workspace::ToggleRightDock",           // AI-агент
      "cmd-shift-d": "diagnostics::Deploy",            // все ошибки проекта

      // задачи (zed/tasks.json)
      "ctrl-r": "task::Spawn",                         // выбрать и запустить
      "ctrl-shift-r": "task::Rerun",                   // повторить последнюю
      "alt-g": ["task::Spawn", { "task_name": "lazygit" }],
      "alt-d": ["task::Spawn", { "task_name": "lazydocker" }],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-b": "git::Blame",                     // blame всего файла
      "cmd-alt-b": "editor::ToggleGitBlameInline",     // blame в строке вкл/выкл
      "cmd-shift-i": "editor::ToggleInlayHints",       // подсказки типов
      "cmd-shift-l": "editor::ToggleIndentGuides",
    },
  },
]
