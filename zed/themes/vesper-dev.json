{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Vesper Dev",
  "author": "dotfiles (на основе Vesper — Rauno Freiberg)",
  "themes": [
    {
      "name": "Vesper Dev",
      "appearance": "dark",
      "style": {
        "background": "#101010",
        "surface.background": "#101010",
        "elevated_surface.background": "#161616",
        "panel.background": "#101010",
        "panel.focused_border": null,
        "status_bar.background": "#101010",
        "title_bar.background": "#101010",
        "title_bar.inactive_background": "#101010",
        "toolbar.background": "#101010",
        "tab_bar.background": "#101010",
        "tab.inactive_background": "#101010",
        "tab.active_background": "#181818",

        "border": "#1e1e1e",
        "border.variant": "#191919",
        "border.focused": "#ffc79955",
        "border.selected": "#ffc79955",
        "border.transparent": "#00000000",
        "border.disabled": "#161616",

        "element.background": "#161616",
        "element.hover": "#1f1f1f",
        "element.active": "#262626",
        "element.selected": "#222222",
        "element.disabled": "#101010",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#1c1c1c",
        "ghost_element.active": "#242424",
        "ghost_element.selected": "#202020",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "#ffc79918",

        "text": "#e8e8e8",
        "text.muted": "#8a8a8a",
        "text.placeholder": "#5a5a5a",
        "text.disabled": "#4a4a4a",
        "text.accent": "#ffc799",
        "icon": "#c8c8c8",
        "icon.muted": "#7a7a7a",
        "icon.disabled": "#4a4a4a",
        "icon.placeholder": "#5a5a5a",
        "icon.accent": "#ffc799",
        "link_text.hover": "#ffc799",

        "search.match_background": "#ffc79933",
        "pane.focused_border": null,
        "pane_group.border": "#1e1e1e",

        "scrollbar.thumb.background": "#ffffff14",
        "scrollbar.thumb.hover_background": "#ffffff24",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#e8e8e8",
        "editor.background": "#101010",
        "editor.gutter.background": "#101010",
        "editor.subheader.background": "#141414",
        "editor.active_line.background": "#171717",
        "editor.highlighted_line.background": "#1c1c1c",
        "editor.line_number": "#3c3c3c",
        "editor.active_line_number": "#a0a0a0",
        "editor.hover_line_number": "#6a6a6a",
        "editor.invisible": "#2c2c2c",
        "editor.wrap_guide": "#181818",
        "editor.active_wrap_guide": "#222222",
        "editor.indent_guide": "#1c1c1c",
        "editor.indent_guide_active": "#333333",
        "editor.document_highlight.read_background": "#ffffff10",
        "editor.document_highlight.write_background": "#ffc7991c",
        "editor.document_highlight.bracket_background": "#ffffff1a",

        "minimap.thumb.background": "#ffffff0d",
        "minimap.thumb.hover_background": "#ffffff1a",
        "minimap.thumb.active_background": "#ffffff26",
        "minimap.thumb.border": "#00000000",

        "terminal.background": "#101010",
        "terminal.foreground": "#e8e8e8",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#7e7e7e",
        "terminal.ansi.black": "#101010",
        "terminal.ansi.bright_black": "#666666",
        "terminal.ansi.red": "#f5a191",
        "terminal.ansi.bright_red": "#ff8080",
        "terminal.ansi.green": "#90b99f",
        "terminal.ansi.bright_green": "#99ffe4",
        "terminal.ansi.yellow": "#e6b99d",
        "terminal.ansi.bright_yellow": "#ffc799",
        "terminal.ansi.blue": "#aca1cf",
        "terminal.ansi.bright_blue": "#b9aeda",
        "terminal.ansi.magenta": "#e29eca",
        "terminal.ansi.bright_magenta": "#ecaad6",
        "terminal.ansi.cyan": "#9ccfd8",
        "terminal.ansi.bright_cyan": "#b8e2e8",
        "terminal.ansi.white": "#a0a0a0",
        "terminal.ansi.bright_white": "#ffffff",

        "created": "#99ffe4",
        "created.background": "#99ffe41a",
        "modified": "#ffc799",
        "modified.background": "#ffc7991a",
        "deleted": "#ff8080",
        "deleted.background": "#ff80801a",
        "conflict": "#ff8080",
        "conflict.background": "#ff80801f",
        "renamed": "#9ccfd8",
        "renamed.background": "#9ccfd81a",
        "ignored": "#4f4f4f",
        "hidden": "#4f4f4f",

        "error": "#ff8080",
        "error.background": "#ff808014",
        "error.border": "#ff808040",
        "warning": "#ffc799",
        "warning.background": "#ffc79914",
        "warning.border": "#ffc79940",
        "info": "#9ccfd8",
        "info.background": "#9ccfd814",
        "info.border": "#9ccfd840",
        "hint": "#6e6e6e",
        "hint.background": "#161616",
        "hint.border": "#222222",
        "success": "#99ffe4",
        "success.background": "#99ffe414",
        "success.border": "#99ffe440",
        "predictive": "#5a5a5a",
        "unreachable": "#6e6e6e",

        "players": [
          { "cursor": "#ffc799", "background": "#ffc799", "selection": "#ffc7992e" },
          { "cursor": "#99ffe4", "background": "#99ffe4", "selection": "#99ffe42e" },
          { "cursor": "#c4a7e7", "background": "#c4a7e7", "selection": "#c4a7e72e" },
          { "cursor": "#9ccfd8", "background": "#9ccfd8", "selection": "#9ccfd82e" }
        ],

        "syntax": {
          "keyword": { "color": "#c4a7e7" },
          "function": { "color": "#ffc799" },
          "function.method": { "color": "#ffc799" },
          "function.builtin": { "color": "#9ccfd8" },
          "constructor": { "color": "#9ccfd8" },
          "type": { "color": "#9ccfd8" },
          "type.builtin": { "color": "#9ccfd8" },
          "namespace": { "color": "#a0a0a0" },
          "module": { "color": "#a0a0a0" },

          "string": { "color": "#99ffe4" },
          "string.escape": { "color": "#ffc799" },
          "string.regex": { "color": "#ffc799" },
          "string.special": { "color": "#99ffe4" },
          "string.special.symbol": { "color": "#f5a191" },
          "text.literal": { "color": "#99ffe4" },

          "number": { "color": "#f5a191" },
          "boolean": { "color": "#f5a191" },
          "constant": { "color": "#f5a191" },
          "constant.builtin": { "color": "#f5a191" },

          "variable": { "color": "#e8e8e8" },
          "variable.parameter": { "color": "#e6d6c8" },
          "variable.special": { "color": "#ff8080" },
          "variable.member": { "color": "#b9aeda" },
          "property": { "color": "#b9aeda" },
          "field": { "color": "#b9aeda" },
          "label": { "color": "#c4a7e7" },
          "attribute": { "color": "#b9aeda" },
          "tag": { "color": "#9ccfd8" },
          "enum": { "color": "#9ccfd8" },
          "variant": { "color": "#f5a191" },

          "operator": { "color": "#9a9a9a" },
          "punctuation": { "color": "#6e6e6e" },
          "punctuation.bracket": { "color": "#8a8a8a" },
          "punctuation.delimiter": { "color": "#6e6e6e" },
          "punctuation.special": { "color": "#c4a7e7" },
          "punctuation.list_marker": { "color": "#ffc799" },

          "comment": { "color": "#5f5f5f", "font_style": "italic" },
          "comment.doc": { "color": "#7a7a7a", "font_style": "italic" },
          "preproc": { "color": "#c4a7e7" },
          "embedded": { "color": "#e8e8e8" },

          "title": { "color": "#ffc799", "font_weight": 700 },
          "emphasis": { "color": "#e8e8e8", "font_style": "italic" },
          "emphasis.strong": { "color": "#ffffff", "font_weight": 700 },
          "link_text": { "color": "#9ccfd8" },
          "link_uri": { "color": "#99ffe4" },
          "hint": { "color": "#5f5f5f", "font_style": "italic" },
          "predictive": { "color": "#4f4f4f", "font_style": "italic" }
        }
      }
    }
  ]
}
