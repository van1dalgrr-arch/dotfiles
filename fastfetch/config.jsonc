{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // своё фото (Ghostty показывает картинки по протоколу kitty); файл вне репозитория — личное.
    // PNG обязателен для kitty-direct; нет файла — fastfetch покажет стандартный логотип
    "type": "kitty-direct",
    "source": "~/.local/share/dotfiles/fastfetch-logo.png",
    "width": 24,
    "height": 12,
    "padding": { "top": 0, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" },
    "key": { "width": 12 }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "blue", "at": "white", "host": "magenta" } },
    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },

    { "type": "os",       "key": "\udb80\udf79  OS",       "keyColor": "blue" },
    { "type": "host",     "key": "\udb80\udf22  Host",     "keyColor": "blue" },
    { "type": "kernel",   "key": "\uf013  Kernel",   "keyColor": "blue" },
    { "type": "uptime",   "key": "\udb80\udd50  Uptime",   "keyColor": "blue" },
    { "type": "packages", "key": "\udb80\udfd6  Pkgs",     "keyColor": "blue" },

    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },

    { "type": "shell",    "key": "\uf489  Shell",    "keyColor": "magenta" },
    { "type": "terminal", "key": "\ue795  Term",     "keyColor": "magenta" },
    { "type": "terminalfont", "key": "\uf031  Font", "keyColor": "magenta" },
    { "type": "wm",       "key": "\uf2d2  WM",       "keyColor": "magenta" },

    { "type": "custom", "format": "\u001b[90m──────────────────────────────" },

    { "type": "cpu",      "key": "\uf4bc  CPU",      "keyColor": "green" },
    { "type": "gpu",      "key": "\udb80\udf5b  GPU",      "keyColor": "green" },
    { "type": "memory",   "key": "\uefc5  RAM",      "keyColor": "green" },
    { "type": "disk",     "key": "\udb80\udeca  Disk",     "keyColor": "green", "folders": "/" },
    { "type": "battery",  "key": "\udb80\udc79  Battery",  "keyColor": "green" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
