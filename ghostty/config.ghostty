# =========================
#   GHOSTTY
# =========================

# --- Theme & font ---
theme = Rose Pine
font-family = JetBrainsMono Nerd Font
font-size = 14
# тонко и плотно, как в терминалах на Linux: без жирнения macOS, почти без доп. межстрочного
font-thicken = false
adjust-cell-height = 4%

# --- Window ---
# Liquid Glass macOS (26+): системное матовое стекло — за окном мягко видно рабочий стол.
# macos-glass-clear — почти прозрачное; вернуть старый вид: opacity 0.94 и blur 20
background-opacity = 0.6
background-blur = macos-glass-regular
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
# Вкладки — обычной полосой во всю ширину (как в Safari), заголовок прозрачный — фон терминала
# доходит до самого верха. Стиль tabs на новой macOS сжимал вкладку в крошечную «таблетку»
# в углу — названий было не видно. Кнопок-светофоров нет, тени нет. Закрыть окно — alt+q
# (AeroSpace) или cmd+w, двигать плавающее окно — ctrl+cmd + тянуть (macos.sh, группа appearance)
macos-titlebar-style = transparent
macos-window-buttons = hidden
macos-window-shadow = false
macos-titlebar-proxy-icon = hidden
# Красная кнопка закрывает окно, Ghostty остаётся в фоне — ctrl+` работает всегда
quit-after-last-window-closed = false
unfocused-split-opacity = 0.85
# названия вкладок — обычным системным шрифтом, читаются легче моноширинного
window-title-font-family = SF Pro Text
# после перезапуска Ghostty (или Mac) окна и вкладки возвращаются на место
window-save-state = always
# AeroSpace постоянно меняет размеры окон — без всплывашки «120×40»
resize-overlay = never
# Иконка в доке в цветах Rosé Pine
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = #ebbcba
macos-icon-screen-color = #191724,#26233a

# --- Cursor ---
# блок без мигания — классика терминалов на Linux (vim и т.п. сами меняют форму)
cursor-style = block
# цвета курсора, выделения и фона сплитов — в темах (themes/apply.sh → ~/.config/ghostty/themes),
# иначе светлая тема не смогла бы их поменять
cursor-style-blink = false
# в промпте Ghostty по умолчанию переключает на черту — пусть остаётся блок
# no-title: заголовок вкладки ставит zsh/title.zsh — со значком программы
shell-integration-features = no-cursor,no-title
# Плавный курсор, шлейф, искры, вспышка фокуса, свечение — шейдеры в shaders/, включаются командой fx
# (она пишет fx.ghostty в конце этого файла: cursor-opacity = 0 и custom-shader = …)

# --- Keys ---
macos-option-as-alt = left
# курсор мыши прячется, пока печатаешь — не загораживает текст
mouse-hide-while-typing = true
scrollback-limit = 50000000
link-url = true

# --- Уведомление, когда долгая команда (docker build, go test…) закончилась,
#     а ты в другом окне ---
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s

# --- Tabs ---
# cmd+t — новая, cmd+w — закрыть, cmd+1…9 — перейти к вкладке, cmd+shift+[ / ] — соседняя (стандартные)
# переставить вкладку влево / вправо
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
# переименовать вкладку (вместо пути — своё название, например «server»)
keybind = cmd+shift+r=prompt_surface_title

# --- Splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# --- Quick terminal (выпадающий по хоткею) ---
quick-terminal-position = top
# не полоса во всю ширину, а «карточка» по центру сверху: 46% высоты, 72% ширины — сразу видно,
# что это выпадающий, а не обычное окно (стекло и прозрачность у всех окон Ghostty общие)
quick-terminal-size = 46%,72%
# плавный выезд/уход: 0.15 было резко, 0.3 — мягко, но без ощущения тормозов
quick-terminal-animation-duration = 0.3
# прячется, когда кликаешь в другое приложение
quick-terminal-autohide = true
# выезжает на текущем рабочем столе, а не перекидывает туда, где был в прошлый раз
quick-terminal-space-behavior = move
# открывается на том мониторе, где мышь
quick-terminal-screen = mouse
# ctrl+` ловит AeroSpace и вызывает ghostty/quick-terminal.applescript — работает из любого приложения
# без «Универсального доступа» для Ghostty (свой global:-хоткей убран, иначе сработали бы оба)
# cmd+q только закрывает окна — Ghostty живёт в фоне, ctrl+` работает всегда
# (выйти совсем: меню Ghostty → Quit)
keybind = super+q=close_all_windows

# --- Тема: themes/apply.sh пишет сюда тему и цвета (перекрывает значения выше) ---
config-file = ?theme.ghostty
# --- Фон из обоев: backdrop пишет сюда картинку (backdrop off — убрать) ---
config-file = ?backdrop.ghostty
# --- Эффекты: fx пишет сюда шейдеры (fx set none — без эффектов) ---
config-file = ?fx.ghostty
# --- Шрифт из ownvim: пишет ownvim из settings.jsonc, раздел font (пусто — шрифт отсюда) ---
config-file = ?ownvim.ghostty
