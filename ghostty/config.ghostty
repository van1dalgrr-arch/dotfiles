# =========================
#   GHOSTTY
# =========================

# --- Theme & font ---
theme = Rose Pine
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# --- Window ---
background-opacity = 0.88
background-blur = 30
window-padding-x = 22
window-padding-y = 18
window-padding-balance = true
macos-titlebar-style = hidden
window-save-state = always
unfocused-split-opacity = 0.85
unfocused-split-fill = #191724
# AeroSpace постоянно меняет размеры окон — без всплывашки «120×40»
resize-overlay = never
# Иконка в доке в цветах Rosé Pine
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = #ebbcba
macos-icon-screen-color = #191724,#26233a

# --- Cursor ---
cursor-style = bar
cursor-color = #ebbcba
selection-background = #403d52
cursor-style-blink = true
shell-integration = zsh
shell-integration-features = no-cursor
# Светящийся шлейф при прыжках курсора (выключить — закомментировать)
custom-shader = shaders/cursor_trail.glsl

# --- Behaviour ---
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
macos-option-as-alt = left
scrollback-limit = 50000000
link-url = true

# --- Quick terminal (выпадающий по хоткею) ---
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-screen = mouse
quick-terminal-autohide = true
keybind = global:ctrl+backquote=toggle_quick_terminal

# --- Splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits
