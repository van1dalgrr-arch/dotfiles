#compdef dot theme wall backdrop awake
# ============================================================
#   Автодополнение (Tab) для своих команд: dot, theme, wall, backdrop, awake.
#   Темы, обои и стили берутся из репозитория — новые появляются в Tab сами.
# ============================================================

_dot_themes()  { local -a t=(~/dotfiles/themes/*.sh(N:t:r)); t=(${t:#apply}); _describe 'тема' t; }
_dot_walls()   { local -a w=(~/dotfiles/icons/wallpaper-*.swift(N:t:r)); w=(${w#wallpaper-}); w=(${w:#kit} ~/Pictures/Wallpapers/photos/*.(jpg|jpeg|png|heic|webp)(N:t:r) add); _describe 'обои' w; }
_dot_backdrops() { local -a s=(glow:'свет из углов' aurora:'сияние снизу' haze:'размытый свет обоев' glass:'обои сквозь стекло' off:'без фона'); _describe 'стиль' s; }
_dot_macos_groups() {
    local -a g=(keyboard trackpad finder saving screenshots dock appearance apps login)
    _arguments '(-y --yes)'{-y,--yes}'[применить]' '(-v --verbose)'{-v,--verbose}'[показать и уже настроенное]' '*:группа:(${g})'
}

_dot() {
    case $service in
        theme)    _dot_themes; return ;;
        wall)     _dot_walls; return ;;
        backdrop) _dot_backdrops; return ;;
        awake)    local -a a=(on:'не засыпать с закрытой крышкой' off:'как обычно'); _describe 'режим' a; return ;;
    esac
    local -a cmds=(
        'doctor:всё ли на месте (--deep — подробно)'
        'project:dot project doctor — проверить проект'
        'install:brew bundle + симлинки + тема'
        'update:обслуживание: brew, Go-утилиты, Docker, иконки'
        'tools:Go-утилиты с закреплёнными версиями'
        'macos:настройки macOS (без --yes — только план)'
        'theme:сменить тему'
        'wall:сменить обои'
        'check:проверки, как в CI'
        'edit:открыть dotfiles в Zed'
        'help:справка'
    )
    if (( CURRENT == 2 )); then _describe 'команда' cmds; return; fi
    case $words[2] in
        doctor)  _arguments '--deep[подробно: версии, ревизии, лишние пакеты]' ;;
        project) (( CURRENT == 3 )) && { local -a p=('doctor:что есть в проекте и чего не хватает'); _describe 'проект' p; } || _directories ;;
        tools)   local -a t=(status install devops); _describe 'действие' t ;;
        macos)   shift words; (( CURRENT-- )); _dot_macos_groups ;;
        theme)   _dot_themes ;;
        wall)    _dot_walls ;;
    esac
}

_dot "$@"
