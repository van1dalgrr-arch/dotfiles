#compdef dot theme wall backdrop awake fx lean work
# ============================================================
#   Автодополнение (Tab) для своих команд: dot, theme, wall, backdrop, awake.
#   Темы, обои и стили берутся из репозитория — новые появляются в Tab сами.
# ============================================================

_dot_themes()  { local -a t=(~/dotfiles/themes/*.sh(N:t:r)); t=(${t:#apply}); _describe 'тема' t; }
_dot_walls()   { local -a w=(~/dotfiles/icons/wallpaper-*.swift(N:t:r)); w=(${w#wallpaper-}); w=(${w:#kit} ~/dotfiles/wallpapers/photos/*.(jpg|jpeg|png|heic|webp)(N:t:r) add); _describe 'обои' w; }
_dot_backdrops() {
    local -a s=(glow:'свет из углов' aurora:'сияние снизу' haze:'размытый свет обоев' glass:'обои сквозь стекло' off:'без фона')
    local -a w=(~/dotfiles/icons/wallpaper-*.swift(N:t:r) ~/dotfiles/wallpapers/photos/*.(jpg|jpeg|png|heic|webp)(N:t:r)); w=(${w#wallpaper-}); w=(${w:#kit})
    _describe 'стиль' s; _describe 'обои как фон' w
}
_dot_fx() {
    if (( CURRENT == 2 )); then local -a a=(on:'включить' off:'выключить' set:'ровно этот набор' list:'что включено'); _describe 'действие' a
    else local -a e=(glow:'свечение текста' cursor:'плавный курсор' trail:'шлейф' sparks:'искры при наборе' focus:'вспышка фокуса' none:'ничего'); _describe 'эффект' e; fi
}
_dot_work() {
    local -a m=(~/dotfiles/work/*.work(N:t:r)) a=(off:'погасить всё до нуля' list:'какие режимы есть')
    _describe 'режим' m; _describe 'действие' a
}
_dot_macos_groups() {
    local -a g=(keyboard trackpad finder saving screenshots dock appearance apps login security)
    _arguments '(-y --yes)'{-y,--yes}'[применить]' '(-v --verbose)'{-v,--verbose}'[показать и уже настроенное]' '*:группа:(${g})'
}

_dot() {
    case $service in
        theme)    _dot_themes; return ;;
        wall)     _dot_walls; return ;;
        backdrop) _dot_backdrops; return ;;
        fx)       _dot_fx; return ;;
        lean)     local -a l=(on:'закрыть тяжёлое из списка' off:'вернуть закрытое'); _describe 'действие' l; return ;;
        work)     _dot_work; return ;;
        awake)    local -a a=(on:'не засыпать с закрытой крышкой' off:'как обычно'); _describe 'режим' a; return ;;
    esac
    local -a cmds=(
        'doctor:всё ли на месте (--deep — подробно, --json — для jq)'
        'project:dot project doctor — проверить проект'
        'install:brew bundle + симлинки + тема'
        'update:обслуживание: brew, Go-утилиты, Docker, иконки'
        'tools:Go-утилиты с закреплёнными версиями'
        'macos:настройки macOS (без --yes — только план)'
        'theme:сменить тему'
        'wall:сменить обои'
        'fx:эффекты Ghostty (шейдеры)'
        'snapshot:снимок системы до/после обновления macOS'
        'work:режим проекта: поднять окружение / off — погасить'
        'sync:подтянуть свежие dotfiles: fast-forward + проверки'
        'backup:бэкап без Time Machine → приватный репозиторий'
        'check:проверки, как в CI'
        'edit:открыть dotfiles в Zed'
        'help:справка'
    )
    if (( CURRENT == 2 )); then _describe 'команда' cmds; return; fi
    case $words[2] in
        doctor)  if (( CURRENT == 3 )); then
                     local -a d=('accept:принять решение (например, без файрвола)' 'unaccept:снова проверять' '--deep:подробно: версии, ревизии, лишние пакеты' '--json:результат в JSON')
                     _describe 'doctor' d
                 elif [[ $words[3] == (accept|unaccept) ]] && (( CURRENT == 4 )); then _values 'решение' firewall
                 fi ;;
        work)    _dot_work ;;
        sync)    _arguments '--yes[применить без вопроса]' ;;
        backup)  _values 'действие' 'status[когда был последний бэкап]' ;;
        project) (( CURRENT == 3 )) && { local -a p=('doctor:что есть в проекте и чего не хватает'); _describe 'проект' p; } || _directories ;;
        tools)   local -a t=(status install devops); _describe 'действие' t ;;
        macos)   shift words; (( CURRENT-- )); _dot_macos_groups ;;
        theme)   _dot_themes ;;
        wall)    _dot_walls ;;
        fx)      shift words; (( CURRENT-- )); _dot_fx ;;
        snapshot) local -a a=(save:'сохранить снимок' diff:'что поменялось между снимками' list:'список снимков'); _describe 'действие' a ;;
    esac
}

_dot "$@"
