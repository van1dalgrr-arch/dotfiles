[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = van1dal
	email = van1dalgrr@gmail.com
[push]
	autoSetupRemote = true
[core]
	pager = delta
	excludesFile = ~/dotfiles/git/ignore
	hooksPath = ~/dotfiles/git/hooks
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hunk-header-style = file line-number syntax
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[init]
	defaultBranch = main
[fetch]
	prune = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt
[rebase]
	autoStash = true
[column]
	ui = auto
# цвета delta: эталон (Rosé Pine), поверх — перекрашенные под текущую тему (themes/apply.sh)
[include]
	path = ~/dotfiles/git/delta.gitconfig
	path = ~/.cache/dotfiles-theme/delta.gitconfig
